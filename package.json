{
	"name": "fauxfetus",
	"private": true,
	"version": "3.1.3",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build/patch-404-fallback.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
		"check:watch": "svelte-kit sync && tsc -p src/service-worker --noEmit && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"generate:data": "tsx ./scripts/data/generate.ts",
		"validate:data": "tsx ./scripts/data/validate.ts",
		"rip": "tsx ./scripts/rip.ts",
		"preview:local": "vite build && node scripts/build/patch-404-fallback.mjs && vite preview",
		"deploy:build": "./scripts/deploy.sh",
		"bump": "./scripts/release.sh"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fauxfetus/data-generator": "workspace:",
		"@fauxfetus/data-validator": "workspace:",
		"@fauxfetus/ripper": "workspace:",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/fs-extra": "catalog:fs-extra",
		"@types/node": "^26.6.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fs-extra": "catalog:fs-extra",
		"globals": "^17.14.0",
		"gray-matter": "^4.0.3",
		"marked": "^18.3.0",
		"prettier": "^3.10.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^7.0.0",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.4.0",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"dependencies": {
		"@regosen/gapless-5": "^1.6.2"
	},
	"packageManager": "pnpm@12.23.0"
}
