{
	"name": "fauxfetus",
	"private": true,
	"version": "2.11.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.sw.json --noEmit",
		"check:watch": "svelte-kit sync && tsc -p tsconfig.sw.json --noEmit && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"data:generate": "tsx ./scripts/data/generate.ts",
		"preview:local": "vite build && vite preview",
		"deploy:build": "./scripts/deploy.sh",
		"release": "./scripts/release.sh"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@fauxfetus/generator": "workspace:",
		"@iconify-json/line-md": "^1.2.14",
		"@iconify/tailwind4": "^1.2.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/fs-extra": "catalog:fs-extra",
		"@types/node": "^22",
		"daisyui": "^5.5.5",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"fs-extra": "catalog:fs-extra",
		"globals": "^16.4.0",
		"marked": "^15.0.0",
		"prettier": "^3.6.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@regosen/gapless-5": "^1.6.2",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.4.0"
